{
        "version": "0.2.0",
        "configurations": [
                {
                        "name": "Launch",
                        "type": "cppdbg",
                        "request": "launch",
                        "preLaunchTask": "xmake build",
                        "program": "${workspaceFolder}/build/linux/x86_64/debug/engine",
                        "args": [],
                        "stopAtEntry": false,
                        "cwd": "${workspaceFolder}/build/linux/x86_64/debug",
                        "environment": [{ "name": "MANGOHUD", "value": "1" }],
                        "externalConsole": true // This line enables the external terminal
                }
        ]
}